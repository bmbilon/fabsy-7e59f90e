{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-Du+OJKJSbdUgz5nrHeWWINvez6XKDDU/tyj/5c2uvwo='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://gcasbisxfrssonllpqrw.supabase.co; connect-src 'self' https://gcasbisxfrssonllpqrw.supabase.co wss://gcasbisxfrssonllpqrw.supabase.co; frame-src 'self' https://gcasbisxfrssonllpqrw.supabase.co blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/start",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/start/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/files",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/files/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sign-in",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/start",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/start/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/files",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/files/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/sign-in",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paralegal/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landlords",
      "destination": "/paralegal/landlords",
      "permanent": true
    },
    {
      "source": "/traffic-tickets",
      "destination": "/paralegal/traffic-tickets",
      "permanent": true
    },
    {
      "source": "/notary",
      "destination": "/paralegal/notary",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/paralegal/privacy",
      "permanent": true
    },
    {
      "source": "/other-matters",
      "destination": "/paralegal/start",
      "permanent": true
    },
    {
      "source": "/paralegal/other-matters",
      "destination": "/paralegal/start",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/paralegal",
      "destination": "/paralegal/index.html"
    },
    {
      "source": "/paralegal/start",
      "destination": "/paralegal/client"
    },
    {
      "source": "/paralegal/start/:path*",
      "destination": "/paralegal/client"
    },
    {
      "source": "/paralegal/files",
      "destination": "/paralegal/client"
    },
    {
      "source": "/paralegal/files/:path*",
      "destination": "/paralegal/client"
    },
    {
      "source": "/paralegal/sign-in",
      "destination": "/paralegal/portal"
    },
    {
      "source": "/paralegal/admin",
      "destination": "/paralegal/portal"
    },
    {
      "source": "/paralegal/admin/:path*",
      "destination": "/paralegal/portal"
    },
    {
      "source": "/start",
      "destination": "/paralegal/client"
    },
    {
      "source": "/start/:path*",
      "destination": "/paralegal/client"
    },
    {
      "source": "/files",
      "destination": "/paralegal/client"
    },
    {
      "source": "/files/:path*",
      "destination": "/paralegal/client"
    },
    {
      "source": "/sign-in",
      "destination": "/paralegal/portal"
    },
    {
      "source": "/admin",
      "destination": "/paralegal/portal"
    },
    {
      "source": "/admin/:path*",
      "destination": "/paralegal/portal"
    }
  ]
}
